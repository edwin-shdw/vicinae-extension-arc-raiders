{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "arc-raiders",
  "title": "Arc Raiders",
  "description": "Access Arc Raiders tools faster",
  "categories": [],
  "license": "MIT",
  "author": "edwin-shdw",
  "contributors": [],
  "pastContributors": [],
  "icon": "extension_icon.png",
  "platforms": ["Linux", "macOS", "Windows"],
  "commands": [
    {
      "name": "map-conditions",
      "title": "Map Conditions",
      "description": "List all active and upcoming Map Conditions",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "region",
      "title": "Region",
      "description": "Your preferred region that will be used as default",
      "type": "dropdown",
      "default": "europe",
      "required": false,
      "data": [
        { "title": "Europe", "value": "europe" },
        { "title": "North America", "value": "north-america" },
        { "title": "South America", "value": "brazil" },
        { "title": "Asia", "value": "east-asia" },
        { "title": "Oceania", "value": "oceania" }
      ]
    }
  ],
  "scripts": {
    "build": "vici build",
    "dev": "vici develop",
    "format": "biome format --write src",
    "lint": "vici lint"
  },
  "dependencies": {
    "@vicinae/api": "^0.29.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.2"
  }
}
